generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RIDER)

  driver Driver?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  ridesAsRider      Ride[]             @relation("RiderRides")
  driverApplication DriverApplication?

  @@index([role])
}

model Driver {
  id            String       @id @default(uuid())
  userId        String       @unique
  licenseNumber String?      @unique
  status        DriverStatus @default(OFFLINE)

  user    User     @relation(fields: [userId], references: [id])
  vehicle Vehicle?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rides     Ride[]   @relation("DriverRides")

  @@index([status])
}

model Vehicle {
  id       String @id @default(uuid())
  driverId String @unique

  make        String
  model       String
  year        Int
  plateNumber String @unique

  driver Driver @relation(fields: [driverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum RideStatus {
  REQUESTED
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideType {
  GO
  PLUS
  XL
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

model Location {
  id String @id @default(uuid())

  label     String
  latitude  Decimal
  longitude Decimal

  createdAt DateTime @default(now())

  pickupRides      Ride[] @relation("PickupLocation")
  destinationRides Ride[] @relation("DestinationLocation")
}

model Ride {
  id String @id @default(uuid())

  riderId  String
  driverId String?

  pickupLocationId      String
  destinationLocationId String

  rideType RideType
  status   RideStatus @default(REQUESTED)

  estimatedFare            Decimal
  estimatedDistanceKm      Decimal
  estimatedDurationMinutes Int

  paymentMethod PaymentMethod?

  rider  User    @relation("RiderRides", fields: [riderId], references: [id])
  driver Driver? @relation("DriverRides", fields: [driverId], references: [id])

  pickupLocation      Location @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  destinationLocation Location @relation("DestinationLocation", fields: [destinationLocationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riderId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

enum DriverApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model DriverApplication {
  id String @id @default(uuid())

  userId String @unique

  status DriverApplicationStatus @default(PENDING)

  licenseNumber String?

  rejectionReason String?

  reviewedAt   DateTime?
  reviewedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
